[Unit]
Description=宜搭项目档案网页
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yida
Group=yida
WorkingDirectory=/opt/yida-archive
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/yida-archive/venv/bin/python -u web/server.py
Restart=on-failure
# 手动提取由独立进程负责；重启网页不终止正在运行的提取。
KillMode=process
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
